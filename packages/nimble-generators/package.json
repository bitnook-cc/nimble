{
  "name": "@nimble/generators",
  "version": "1.0.0",
  "private": true,
  "description": "Offline name and NPC generators for Nimble RPG",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@nimble/shared-config": "1.0.0",
    "@eslint/js": "^9.35.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
