{
  "name": "@nimble/slate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3010",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3010",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "test:ui": "playwright test e2e/ui.spec.ts",
    "test:ui:update": "playwright test e2e/ui.spec.ts --update-snapshots=all",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "test:e2e:cross": "playwright test --config playwright.cross.config.ts",
    "build:all": "npm run build -w @nimble/dice && npm run build -w @nimble/generators && npm run build",
    "cap:prepare": "npm run build:all && cap sync && npm run cap:verify",
    "cap:verify": "node scripts/verify-native.mjs",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:release": "playwright test e2e/release.spec.ts"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@nimble/dice": "1.0.0",
    "@nimble/generators": "1.0.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
