        "included": [
          {
            "type": "families",
            "id": "0gf54dznx891maj94wsf7th58a",
            "attributes": {
              "name": "Orcs",
              "description": "Mighty, battle-born warriors that train endlessly to resist blades and arrows. Only the greatest\nOrcs dare use the arcane, and even they do so with reverence and fear. Adolescent Orcs must\ntravel with a warband and return alive before they are considered full citizens and adults. They\nwage war for the love of battle alone, razing cities and salting the earth in their wake. The warbands that\nfind enough glory return to their homes proud and victorious. Those that don't, simply never return.",
              "abilities": [
                {
                  "name": "Battlelust",
                  "description": "Heroes have disadvantage on Initiative against an Orcish band."
                },
                {
                  "name": "Tough as Nails",
                  "description": "Orcs have Medium armor, except against magic damage."
                }
              ]
            },
            "relationships": {},
